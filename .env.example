# MontirGo — contoh environment. Salin menjadi .env.local lalu isi nilainya.
# JANGAN commit file .env / .env.local yang sudah terisi ke git.
# Ambil nilai Supabase dari: Supabase Dashboard > Project Settings > API.

# --- Supabase (dipakai aplikasi mobile, prefix EXPO_PUBLIC_ agar terbaca Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini

# --- Backend / Edge Function saja (JANGAN pakai prefix EXPO_PUBLIC_, jangan taruh di aplikasi) ---
# Service role key: hanya untuk backend / Edge Function / webhook payment & AI.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
# Opsional: URL database langsung (untuk migrasi via CLI / tooling)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xyzcompany.supabase.co:5432/postgres

# --- AI (server-side saja, PRD §11: key tidak boleh di mobile app) ---
# Provider harus OpenAI-compatible. Contoh Groq:
#   AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
#   AI_PROVIDER_MODEL=openai/gpt-oss-120b
AI_PROVIDER_API_KEY=isi-api-key-ai-di-sini
AI_PROVIDER_MODEL=openai/gpt-oss-120b
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1

# --- Xendit (server-side saja, PRD §17 — JANGAN pakai prefix EXPO_PUBLIC_) ---
# Secret key dari Dashboard Xendit > Settings > API Keys (mode Development/Test dulu).
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxx
# Callback token dari Dashboard Xendit > Settings > Webhooks.
XENDIT_WEBHOOK_TOKEN=isi-callback-token-pembayaran
# Opsional: bila webhook payout memakai token berbeda.
XENDIT_PAYOUT_WEBHOOK_TOKEN=
# Opsional: override base URL (mis. mock server saat uji lokal).
# XENDIT_BASE_URL=https://api.xendit.co

# Persentase fee platform. Bila kosong, nilai dari tabel platform_settings dipakai.
PLATFORM_FEE_PERCENT=10

# Return URL checkout Xendit. WAJIB https:// bila diisi (mis. deep link web).
# APP_PAYMENT_RETURN_URL=https://montirgo.app/payment/return

# Data alamat bisnis untuk recipient payout Xendit v3.
# XENDIT_COMPANY_ADDRESS=Jl. Jenderal Sudirman No. 1
# XENDIT_COMPANY_CITY=Jakarta
# XENDIT_COMPANY_PROVINCE=DKI Jakarta
# XENDIT_COMPANY_POSTAL_CODE=12190

# --- Maps / routing (boleh public, dibatasi via API key restriction) ---
# Key ini hanya untuk rute & ETA (Routes API). Peta yang tampil di aplikasi
# memakai WebView + tile OpenStreetMap, jadi tidak butuh Maps SDK.
# Di Google Cloud: aktifkan "Routes API" (atau "Directions API" lama) + billing,
# lalu batasi key ke API tersebut.
EXPO_PUBLIC_MAPS_API_KEY=isi-maps-api-key-di-sini

# --- Tile peta WebView (opsional) ---
# Default: tile OpenStreetMap publik. Untuk produksi pakai penyedia ber-SLA,
# mis. MapTiler/Carto, agar tidak melanggar kebijakan pemakaian tile OSM.
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=xxx
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# --- Legacy: backend Express lokal (opsional, jika masih dipakai bersamaan) ---
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
