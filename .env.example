# MontirGo — contoh environment MOBILE APP.
# Salin menjadi `.env.local` lalu isi nilainya.
#
# PENTING:
#   - File ini HANYA boleh memuat variabel ber-prefix `EXPO_PUBLIC_*` yang aman di aplikasi mobile.
#   - JANGAN PERNAH menaruh `SUPABASE_SERVICE_ROLE_KEY`, `SUPABASE_DB_URL`, `XENDIT_SECRET_KEY`,
#     atau `AI_PROVIDER_API_KEY` di sini. Gunakan `supabase/.env` (lihat `supabase/.env.example`).
#   - JANGAN commit file `.env` / `.env.local` yang sudah terisi ke git.

# --- Supabase (public client key) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini

# --- Maps / Routing (wajib dibatasi per API & app restriction di Google Cloud) ---
EXPO_PUBLIC_MAPS_API_KEY=isi-maps-api-key-di-sini

# --- Routing fallback & Tile Peta (untuk produksi ganti ke server/penyedia ber-SLA) ---
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=xxx
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
