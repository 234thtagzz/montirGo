# Expo Go di HP fisik TIDAK bisa pakai localhost (localhost = HP itu sendiri).
# Ganti dengan IP LAN laptop (lihat via ipconfig), contoh:
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
# Android emulator pakai: http://10.0.2.2:5000
# Web di laptop yang sama boleh: http://localhost:5000
# Cara pakai (PowerShell):
#   $env:EXPO_PUBLIC_API_URL="http://192.168.1.10:5000"; npx expo start --clear
