# MontirGo — contoh environment. Salin menjadi .env.local lalu isi nilainya.
# JANGAN commit file .env / .env.local yang sudah terisi ke git.
# Ambil nilai Supabase dari: Supabase Dashboard > Project Settings > API.

# --- Supabase (dipakai aplikasi mobile, prefix EXPO_PUBLIC_ agar terbaca Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini

# --- Backend / Edge Function saja (JANGAN pakai prefix EXPO_PUBLIC_, jangan taruh di aplikasi) ---
# Service role key: hanya untuk backend / Edge Function / webhook payment & AI.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
# Opsional: URL database langsung (untuk migrasi via CLI / tooling)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xyzcompany.supabase.co:5432/postgres

# --- AI (server-side saja, PRD §11: key tidak boleh di mobile app) ---
AI_PROVIDER_API_KEY=isi-api-key-ai-di-sini
AI_PROVIDER_MODEL=gpt-4o-mini

# --- Payment gateway QRIS (server-side saja, PRD §17) ---
PAYMENT_GATEWAY_API_KEY=isi-payment-gateway-key-di-sini
PAYMENT_GATEWAY_WEBHOOK_SECRET=isi-webhook-secret-di-sini

# --- Maps / routing (boleh public, dibatasi via API key restriction) ---
EXPO_PUBLIC_MAPS_API_KEY=isi-maps-api-key-di-sini

# --- Legacy: backend Express lokal (opsional, jika masih dipakai bersamaan) ---
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
