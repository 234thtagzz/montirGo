# MontirGo — Server-Side Secrets untuk Supabase Edge Functions.
# Salin menjadi `supabase/.env` untuk pengujian lokal (`npx supabase functions serve` / `supabase start`).
# Untuk Staging & Production, kirim lewat: `npx supabase secrets set --env-file supabase/.env`
# JANGAN pernah menaruh variabel di file ini ke `.env` / `.env.local` mobile atau men-commit nilai asli ke git.

# --- AI Provider (OpenAI-compatible, mis. Groq) ---
AI_PROVIDER_API_KEY=gsk_isi_api_key_ai_di_sini
AI_PROVIDER_MODEL=openai/gpt-oss-120b
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1

# --- Xendit Payment & Payout v3 ---
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=isi-callback-token-pembayaran
XENDIT_PAYOUT_WEBHOOK_TOKEN=isi-callback-token-payout
# Opsional: override base URL untuk mock server / pengujian lokal
# XENDIT_BASE_URL=https://api.xendit.co

# Pengaturan fallback jika tabel platform_settings belum terisi
PLATFORM_FEE_PERCENT=10

# Return URL checkout Xendit (WAJIB https:// bila diisi)
# APP_PAYMENT_RETURN_URL=https://montirgo.app/payment/return

# Alamat bisnis pengirim payout Xendit v3
XENDIT_COMPANY_ADDRESS=Jl. Jenderal Sudirman No. 1
XENDIT_COMPANY_CITY=Jakarta
XENDIT_COMPANY_PROVINCE=DKI Jakarta
XENDIT_COMPANY_POSTAL_CODE=12190

# --- Push Notification Dispatcher (send-push-notification) ---
# Secret header `x-webhook-secret` untuk Supabase Database Webhook pada INSERT notifications
PUSH_WEBHOOK_SECRET=isi-secret-acak-panjang-untuk-webhook-push
# Opsional: Expo Access Token bila Enhanced Push Security diaktifkan di akun Expo
# EXPO_ACCESS_TOKEN=
