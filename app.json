{
  "expo": {
    "name": "montirGo",
    "slug": "montirGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "montirgo",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6BFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B6BFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#0B74E5",
          "defaultChannel": "requests",
          "sounds": [
            "./assets/sounds/montirgo_alert.mp3",
            "./assets/sounds/montirgo_alert_ios.aiff"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MontirGo memakai foto galeri untuk menambahkan foto kendaraan agar montir bisa menganalisis kondisinya.",
          "cameraPermission": "MontirGo memakai kamera agar montir dapat memotret bukti kerusakan kendaraan saat mengirim estimasi biaya.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "76698576-5199-4764-89f3-0527de206387"
      }
    },
    "owner": "elfarizi"
  }
}
