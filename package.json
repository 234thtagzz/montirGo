    "eslint-config-expo": "~58.0.4",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "login": "expo login",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "android:build": "expo run:android",
    "ios:build": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:types": "npx supabase gen types typescript --local > src/lib/database.types.ts",
    "supabase:push": "npx supabase db push",
    "supabase:deploy": "npx supabase functions deploy analyze-request && npx supabase functions deploy ai-assistant && npx supabase functions deploy xendit-create-payment && npx supabase functions deploy xendit-sync-payment && npx supabase functions deploy xendit-request-withdrawal && npx supabase functions deploy xendit-sync-withdrawal && npx supabase functions deploy confirm-cash-payment && npx supabase functions deploy xendit-webhook --no-verify-jwt && npx supabase functions deploy xendit-payout-webhook --no-verify-jwt && npx supabase functions deploy send-push-notification --no-verify-jwt",
    "supabase:check": "npx -y deno@2 check supabase/functions/analyze-request/index.ts supabase/functions/ai-assistant/index.ts supabase/functions/xendit-create-payment/index.ts supabase/functions/xendit-sync-payment/index.ts supabase/functions/xendit-request-withdrawal/index.ts supabase/functions/xendit-sync-withdrawal/index.ts supabase/functions/confirm-cash-payment/index.ts supabase/functions/xendit-webhook/index.ts supabase/functions/xendit-payout-webhook/index.ts supabase/functions/send-push-notification/index.ts",
    "supabase:test:functions": "npx -y deno@2 test --allow-net --allow-env supabase/functions/tests/",
    "supabase:fmt": "npx -y deno@2 fmt supabase/functions",
    "supabase:verify": "node scripts/verify-ai-functions.mjs",
    "test:backend": "node supabase/tests/rls_and_workflow.test.mjs"
  },
  "private": true
}
